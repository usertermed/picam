[Unit]
Description=Raspberry Pi Security Camera
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/security-camera
ExecStart=/bin/bash -lc 'source /home/pi/security-camera/venv/bin/activate && exec python /home/pi/security-camera/app.py'
Restart=on-failure
RestartSec=5
Environment=PATH=/home/pi/security-camera/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
